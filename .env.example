# Copy this file to .env and fill values locally. Never commit real credentials.
# .env and atlas-credentials.env are gitignored; this template must stay empty.

# Alpaca paper trading credentials (required to run `python run.py`).
# The trading venue reads ALPACA_*; the market-data stream reads APCA_*.
# Setting either pair is enough — run.py mirrors one to the other at startup.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets/v2
ENGINE_NATIVE_ADAPTER_MODULE=native_adapters

# MongoDB journal storage. Supply the credentialed URI only in the ignored
# .env file (or provide MONGODB_URI via atlas-credentials.env; run.py mirrors
# it to CENGINE_MONGODB_URI).
CENGINE_MONGODB_URI=
CENGINE_MONGODB_DATABASE=cengine
# MONGODB_URI=   # mirrored to CENGINE_MONGODB_URI at startup if set

# ---------------------------------------------------------------------------
# Market-data feed (IEX is the default; it is never auto-replaced by SIP).
# Selecting the feed changes ONLY the data source, never paper vs. live
# trading (that is gated separately below).
# ---------------------------------------------------------------------------
# CENGINE_ALPACA_FEED=iex          # iex (default) | sip | delayed_sip | boats | overnight
# CENGINE_ALPACA_SANDBOX=0         # 1 to use the sandbox market-data host
# CENGINE_ALPACA_URL=              # explicit validated full wss:// URL (overrides FEED)
# CENGINE_ARCHIVE_PROVIDER_LABEL=  # defaults to the feed label, e.g. alpaca-iex
#
# SIP requires an entitled Alpaca market-data subscription. To use it:
#   CENGINE_ALPACA_FEED=sip
#   CENGINE_ARCHIVE_PROVIDER_LABEL=alpaca-sip   # optional; defaults to alpaca-sip

# Optional no-argument run knobs (defaults shown). All are overridable here.
# CENGINE_SYMBOLS=QQQ,SQQQ
# CENGINE_RISK_FRACTION=0.02
# CENGINE_ATR_PERIOD=14
# CENGINE_ATR_FALLBACK_SHARES=1
# CENGINE_RECONCILIATION_INTERVAL_SECONDS=15
# CENGINE_JOURNAL_PATH=./state/audit.jsonl
# CENGINE_MARKET_DATA_ROOT=./state/market_data
# CENGINE_MONGODB_TIMEOUT_MS=5000

# Live mode requires the live URL plus all exact confirmations below.
# ALPACA_TRADING_BASE_URL=https://api.alpaca.markets
# CENGINE_ENABLE_LIVE=YES_I_ACCEPT_LIVE_TRADING_RISK
# CENGINE_LIVE_CONFIRMATION=LIVE_ORDERS_MAY_LOSE_MONEY
# CENGINE_LIVE_RECONCILIATION_CERTIFIED=PAPER_REPLAY_AND_BROKER_STATE_AGREE

# ---------------------------------------------------------------------------
# Unified entry point: `python3 trade.py` (paper default). Modes:
#   --paper --live --shadow --validate --status
# `trade.py` loads the canonical universe.txt, starts the migrated market
# scanner, and delegates the engine lifecycle to run.py. The scanner reuses the
# ALPACA_* trading credentials above for its IEX market-data stream.
#
# Spec-compatibility aliases: the project spec refers to ALPACA_BASE_URL and
# ALPACA_DATA_FEED. This repo's canonical names are ALPACA_TRADING_BASE_URL
# (trading endpoint, above) and CENGINE_ALPACA_FEED (engine data feed, above).
# The scanner additionally honours MARKET_SCAN_DATA_FEED (and falls back to
# ALPACA_DATA_FEED). IEX is forced for the scanner regardless.
# ---------------------------------------------------------------------------

# Market scanner (migrated market_scan/ package). Enabled by default.
# MARKET_SCAN_ENABLED=1                 # 0 disables the in-process scanner
# MARKET_SCAN_DATA_FEED=iex             # SIP is coerced to IEX for the scanner
# MARKET_SCAN_RANK_SECONDS=3            # candidate ranking cadence
# MARKET_SCAN_DISCOVERY_SECONDS=300     # asset-discovery cadence
# MARKET_SCAN_TARGET_SIZE=30            # published entry-universe size
# MARKET_SCAN_MAX_SUBSCRIPTIONS=30      # IEX subscription budget
# MARKET_SCAN_MIN_PRICE=5.0
# MARKET_SCAN_MIN_ADV=500000
# MARKET_SCAN_MIN_ADDV=25000000
# MARKET_SCAN_MAX_SPREAD_PCT=0.0010
# MARKET_SCAN_LOSS_THRESHOLD=-0.005     # mandatory position loss-removal trigger
# MARKET_SCAN_LOSS_MONITOR=1            # independent -0.5% monitor on/off
# MARKET_SCAN_LOSS_MONITOR_SECONDS=5    # monitor backstop cadence
# MARKET_SCAN_REQUIRE_SELLER_EXHAUSTION=0
# MARKET_SCAN_REPLACE_ENABLED=1
# TRADE_LOG_LEVEL=INFO

# DI/BB strategy (migrated from QQ-Trader). OPT-IN: the engine only trades it
# when CENGINE_DIBB_ENABLED=1 (an unvalidated strategy never gains execution
# eligibility silently). Long-only; entries are revalidated against the canonical
# universe + native risk. Empirical validation is a backtest/replay task.
# CENGINE_DIBB_ENABLED=0
# CENGINE_DIBB_DI_PERIOD=14
# CENGINE_DIBB_BB_PERIOD=20
# CENGINE_DIBB_MOMENTUM_LOOKBACK=5
# CENGINE_DIBB_REQUIRE_VWAP=1
# CENGINE_DIBB_REQUIRE_MOMENTUM=1

# Dynamic universe resubscription (Milestone 3/4). On by default; an explicit
# CENGINE_SYMBOLS override pins symbols and disables it.
# CENGINE_DYNAMIC_UNIVERSE=1
# CENGINE_UNIVERSE_SYNC_SECONDS=5

# Apple Metal GPU analytics (optional; Apple Silicon only). The engine discovers
# the compiled cengine.metallib automatically across build dirs; override with
# CENGINE_METALLIB. GPU is analytics-only and never gates native risk or the
# mandatory -0.5% protective exits (CPU fallback is automatic).
#   python3 trade.py --validate-metal     # integration report + reports/*.json
#   python3 trade.py --benchmark-metal    # GPU vs CPU latency
#   cmake -S . -B build-metal -DCENGINE_COMPILE_METAL=ON && cmake --build build-metal -j
# CENGINE_METALLIB=build/cengine.metallib
