# Copy this file to .env and fill values locally. Never commit real credentials.
# .env and atlas-credentials.env are gitignored; this template must stay empty.

# Alpaca paper trading credentials (required to run `python run.py`).
# The trading venue reads ALPACA_*; the market-data stream reads APCA_*.
# Setting either pair is enough — run.py mirrors one to the other at startup.
ALPACA_API_KEY=PKHLDX6OYV6ILQYR32FUTVLRHA
ALPACA_SECRET_KEY=8ffcEX7WWTGnkyB7YmxfmVGPPbFZymSnXqFTm8vvodyW
ATLAS_URI=mongodb+srv://contact_db_user:<db_password>@nonl0cal.4nwbija.mongodb.net/

# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets/v2
ENGINE_NATIVE_ADAPTER_MODULE=native_adapters

# MongoDB journal storage. Supply the credentialed URI only in the ignored
# .env file (or provide MONGODB_URI via atlas-credentials.env; run.py mirrors
# it to CENGINE_MONGODB_URI).
CENGINE_MONGODB_URI=
CENGINE_MONGODB_DATABASE=cengine

# Optional no-argument run knobs (defaults shown). All are overridable here.
# CENGINE_SYMBOLS=QQQ,SQQQ
# CENGINE_ALPACA_FEED=sip          # sip | iex | delayed_sip | boats | overnight
# CENGINE_ALPACA_SANDBOX=0         # 1 to use the sandbox market-data host
# CENGINE_ALPACA_URL=              # explicit full wss:// URL (overrides FEED)
# CENGINE_RISK_FRACTION=0.02
# CENGINE_ATR_PERIOD=14
# CENGINE_ATR_FALLBACK_SHARES=1
# CENGINE_RECONCILIATION_INTERVAL_SECONDS=15
# CENGINE_JOURNAL_PATH=./state/audit.jsonl
# CENGINE_MARKET_DATA_ROOT=./state/market_data
# CENGINE_MONGODB_TIMEOUT_MS=5000

# Live mode requires the live URL plus all exact confirmations below.
# ALPACA_TRADING_BASE_URL=https://api.alpaca.markets
# CENGINE_ENABLE_LIVE=YES_I_ACCEPT_LIVE_TRADING_RISK
# CENGINE_LIVE_CONFIRMATION=LIVE_ORDERS_MAY_LOSE_MONEY
# CENGINE_LIVE_RECONCILIATION_CERTIFIED=PAPER_REPLAY_AND_BROKER_STATE_AGREE
